      "dur": 5.2,
      "lines": [
        {
          "who": "narrator",
          "text": "बैंक के सिस्टम को लगा, ये असली रमेश जी हैं। पैसे निकले, और आया सिर्फ़ डेबिट का SMS।",
          "file": "audio/ep2/l-05-1.mp3",
          "start": 0.12,
          "dur": 4.78
