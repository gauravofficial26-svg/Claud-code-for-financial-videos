      "dur": 5.122,
      "lines": [
        {
          "who": "scammer",
          "text": "बस एक नकली सिलिकॉन निशान, और ये छोटी मशीन... काम हो गया।",
          "file": "audio/ep2/l-04-1.mp3",
          "start": 0.12,
          "dur": 4.702
