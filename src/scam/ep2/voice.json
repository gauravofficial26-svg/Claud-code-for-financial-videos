      "dur": 9.638,
      "lines": [
        {
          "who": "neha",
          "text": "पापा, घबराइए मत। चलिए, आधार बायोमेट्रिक लॉक करते हैं।",
          "file": "audio/ep2/l-06-1.mp3",
