          "start": 0.12,
          "dur": 2.011
        },
        {
          "who": "narrator",
          "text": "जाँच हुई, और पुलिस पहुँची राहुल के पास, ठग के पास नहीं।",
          "file": "audio/ep1/l-06-2.mp3",
          "start": 2.311,
          "dur": 4.885
        },
        {
          "who": "police",
          "text": "राहुल आप ही हैं? थाने चलना होगा।",
          "file": "audio/ep1/l-06-3.mp3",
          "start": 7.376,
          "dur": 2.09
        }
      ]
    },
    {
      "id": "station",
      "mood": "dark",
      "start": 48.654,
      "dur": 13.528,
      "lines": [
        {
          "who": "police",
          "text": "तुम्हारे खाते से ठगी का पैसा आगे गया है।",
          "file": "audio/ep1/l-07-1.mp3",
          "start": 0.12,
          "dur": 2.664
        },
        {
          "who": "rahul",
          "text": "सर, मुझे सच में नहीं पता था!",
          "file": "audio/ep1/l-07-2.mp3",
          "start": 2.964,
          "dur": 1.646
        },
        {
          "who": "narrator",
          "text": "मुझे पता नहीं था, कहने से बचाव नहीं होता। RBI के मुताबिक, अनजाने में भी जाँच, और जेल तक हो सकती है।",
          "file": "audio/ep1/l-07-3.mp3",
          "start": 4.79,
          "dur": 8.438
        }
      ]
