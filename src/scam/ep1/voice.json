    {
      "id": "rightWay",
      "mood": "hope",
      "start": 54.917,
      "dur": 7.232,
      "lines": [
        {
          "who": "narrator",
          "text": "ऐसा मैसेज आए, तो ब्लॉक कीजिए।",
          "file": "audio/ep1/l-08-1.mp3",
          "start": 0.12,
          "dur": 1.829
        },
        {
          "who": "rahul",
          "text": "ना भाई, मेरा खाता किराए के लिए नहीं है!",
          "file": "audio/ep1/l-08-2.mp3",
          "start": 2.129,
          "dur": 1.959
        },
        {
          "who": "narrator",
          "text": "खाता, कार्ड, OTP और PIN, किसी को मत दीजिए।",
          "file": "audio/ep1/l-08-3.mp3",
          "start": 4.268,
          "dur": 2.664
        }
      ]
    },
